# ============================================================
#  TALKLESS ULTRA XMD – environment template
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#  Never commit .env. All values below are REQUIRED unless
#  marked optional.
# ============================================================

# ── Telegram (admin / command channel) ──────────────────────
TELEGRAM_TOKEN=
OWNER_TELEGRAM_ID=your_numeric_telegram_id
OWNER_NAME=talkless
BOT_NAME=𝐓𝐀𝐋𝐊𝐋𝐄𝐒𝐒 𝐔𝐋𝐓𝐑𝐀
BOT_VERSION=4.0.0
COMPANY=TALKLESS ULTRA
CREDITS=talkless

# ── WhatsApp ────────────────────────────────────────────────
# Extra owner WhatsApp number (also used as the wa.me link shown in .menu)
SUDO_NUMBER=
ANTIDELETE_OWNER=
# Session storage directory (keep on a PERSISTENT volume on the panel)
SESSION_DIR=./sessions
DEFAULT_PREFIX=.
MENU_AUDIO_PATH=./media/menu-audio.mp3

# ── Neon (REQUIRED for website pairing) ─────────────────────
# Connection string of the Neon DB that the pairing website writes to.
# Apply schema-talkless.sql there once.
NEON_DATABASE_URL=

# ── GitHub session backup (optional) ────────────────────────
# Classic PAT with repo scope if you want sessions synced to a GitHub repo.
GITHUB_TOKEN=
GITHUB_USERNAME=talkless
GITHUB_REPO=database
GITHUB_BRANCH=main

# ── Ping / monitoring ───────────────────────────────────────
PANEL_URL=
WEBSITE_URL=https://talkless-pairing.vercel.app

# ── Vercel (optional) ───────────────────────────────────────
# Token used for Vercel platform calls / site deploys.
# A default is baked into settings.js; override here if you rotate it.
VERCEL_TOKEN=

# ── Verification (optional) ─────────────────────────────────
REQUIRED_CHANNEL=
REQUIRED_GROUP=
REQUIRED_CHANNEL_LINK=
REQUIRED_GROUP_LINK=
REQUIRED_CHANNEL_ID=
REQUIRED_GROUP_ID=

# ── Telegram fallback bot info (optional) ───────────────────
# OWNER_TELEGRAM_IDS was used by older versions; single OWNER_TELEGRAM_ID is current.
